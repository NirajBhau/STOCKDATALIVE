# Investing.com Watchlist URL
INVESTING_URL=https://www.investing.com/watchlist/

# Continuous monitoring refresh interval in seconds (default: 10)
SCRAPE_INTERVAL_SECONDS=2

# Google Sheets Configuration
GOOGLE_SHEET_ID=1YourGoogleSheetIDGoesHere
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# Local Timezone for extraction timestamps
TIMEZONE=Asia/Kolkata

# Browser headless mode (set to false for first-time manual login)
HEADLESS=false
